@* AUDIT:FIXED|byl: @implements IDisposable chyběl – timer leak *@
@page "/search"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContextAiData> DbFactory

<PageTitle>Hledání — VO2 Data Manager</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-search me-2"></i>Globální hledání</h3>
</div>

<div class="ui-panel ui-anim-fade-up mb-3">
    <div class="p-3 d-flex gap-3 align-items-end flex-wrap">
        <div style="flex:1;min-width:200px">
            <input class="form-control" placeholder="Hledat tým, ligu, hráče, agenta…"
                   @bind="_query" @bind:event="oninput" @bind:after="OnQueryChange" />
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @foreach (var s in _sources)
            {
                <button class="btn btn-sm @(_active.Contains(s.Key) ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => ToggleSource(s.Key)">
                    @s.Icon @s.Label
                </button>
            }
        </div>
    </div>
</div>

@if (_searching)
{
    <div class="d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Hledám…</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_query) && _query.Length >= 2)
{
    var total = _results.Sum(r => r.Value.Count);

    @if (_unavailable.Count > 0)
    {
        <div class="alert alert-warning py-2 small ui-anim-fade-up">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Nedostupné kategorie (tabulka v AIData zatím neexistuje nebo má jiné schéma):
            @string.Join(", ", _unavailable)
        </div>
    }

    @if (total == 0)
    {
        <div class="ui-panel ui-anim-fade-up text-center p-4 text-muted">Nic nenalezeno pro „@_query".</div>
    }
    else
    {
        <div class="text-muted small mb-3">Nalezeno @total výsledků</div>

        @foreach (var s in _sources.Where(s => _active.Contains(s.Key)
                                            && _results.ContainsKey(s.Key)
                                            && _results[s.Key].Count > 0))
        {
            var rows = _results[s.Key];
            <div class="ui-panel ui-anim-fade-up mb-3">
                <div class="ui-panel-header">
                    <span class="ui-panel-title">@s.Icon @s.Label</span>
                    <span class="badge bg-secondary">@rows.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <tbody>
                            @foreach (var r in rows)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @if (s.LinkPrefix is not null)
                                        {
                                            <a href="@(s.LinkPrefix + Uri.EscapeDataString(r.Name ?? ""))"
                                               class="text-decoration-none">@Display(r.Name)</a>
                                        }
                                        else
                                        {
                                            @Display(r.Name)
                                        }
                                    </td>
                                    <td class="text-muted small">@(r.Detail ?? "—")</td>
                                    <td class="text-muted small text-nowrap">
                                        @(r.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
else if (!string.IsNullOrWhiteSpace(_query))
{
    <div class="text-muted small">Zadejte alespoň 2 znaky…</div>
}

@code {
    // Přepsáno 2026-09-12: původní verze hledala přes EF entity Artist/Album/Song a AmericanFootball*,
    // které míří na neexistující tabulky → stránka spadla na prvním dotazu. Teď raw SQL nad reálným
    // schématem a každá kategorie ve vlastním try/catch, takže chybějící tabulka shodí jen svou sekci.

    private string _query = "";
    private bool _searching;
    private System.Timers.Timer? _debounce;

    private readonly Dictionary<string, List<Row>> _results = new();
    private readonly List<string> _unavailable = new();

    /// <summary>Zdroj hledání. NameExpr/DetailExpr jsou konstanty z kódu — nikdy uživatelský vstup.</summary>
    private sealed record Source(string Key, string Label, string Icon, string Table,
                                 string NameExpr, string DetailExpr, string? LinkPrefix = null);

    // Sporty mají nekonzistentní schéma (AmFootball* nemá Name), proto se výraz pro název konfiguruje per zdroj.
    private readonly Source[] _sources =
    [
        new("agents",     "Agenti",           "🤖", "AgentSchedules",   "\"AgentName\"",      "COALESCE(\"AgentType\",'')", "/agents/"),
        new("bk_teams",   "Basketbal — týmy", "🏀", "BasketballTeams",  "\"Name\"",           "COALESCE(\"Country\",'')"),
        new("bk_leagues", "Basketbal — ligy", "🏆", "BasketballLeagues","\"Name\"",           "COALESCE(\"Country\",'')"),
        new("bk_players", "Basketbal — hráči","⛹️", "BasketballPlayers","\"Name\"",           "COALESCE(\"Country\",'')"),
        new("amf_teams",  "Am. fotbal — týmy","🏈", "AmFootballTeams",  "\"NormalizedName\"", "COALESCE(\"SourceName\",'')"),
        new("fb_teams",   "Fotbal — týmy",    "⚽", "FootballTeams",    "\"Name\"",           "COALESCE(\"Country\",'')"),
    ];

    private HashSet<string> _active = [];

    // Ve výchozím stavu hledáme všude; konstruktor komponenty se v Razoru nepoužívá.
    protected override void OnInitialized() => _active = _sources.Select(s => s.Key).ToHashSet();

    private void OnQueryChange()
    {
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(400) { AutoReset = false };
        _debounce.Elapsed += async (_, _) => await InvokeAsync(SearchAsync);
        _debounce.Start();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _query.Length < 2)
        {
            _results.Clear();
            _unavailable.Clear();
            StateHasChanged();
            return;
        }

        _searching = true;
        StateHasChanged();

        var pattern = $"%{_query}%";
        _results.Clear();
        _unavailable.Clear();

        foreach (var s in _sources.Where(s => _active.Contains(s.Key)))
        {
            // Agentní tabulky vznikají postupně — jedna chybějící nesmí shodit celé hledání.
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var sql = $$"""
                    SELECT {{s.NameExpr}} AS "Name", {{s.DetailExpr}} AS "Detail", "UpdatedAt"
                    FROM "{{s.Table}}"
                    WHERE "IsDeleted" = false AND {{s.NameExpr}} ILIKE {0}
                    ORDER BY {{s.NameExpr}}
                    LIMIT 20
                    """;
                _results[s.Key] = await db.Database.SqlQueryRaw<Row>(sql, pattern).ToListAsync();
            }
            catch
            {
                _unavailable.Add(s.Label);
            }
        }

        _searching = false;
        StateHasChanged();
    }

    private void ToggleSource(string key)
    {
        if (!_active.Remove(key)) _active.Add(key);
    }

    // AmFootball* drží názvy jen malými písmeny (normalizované) — pro zobrazení je zkulturníme.
    private static string Display(string? name) => string.IsNullOrWhiteSpace(name)
        ? "—"
        : (name == name.ToLowerInvariant()
            ? System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(name)
            : name);

    public void Dispose() => _debounce?.Dispose();

    private class Row
    {
        public string? Name { get; set; }
        public string? Detail { get; set; }
        public DateTimeOffset? UpdatedAt { get; set; }
    }
}
